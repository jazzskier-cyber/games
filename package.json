{
  "name": "jazzskier-games",
  "version": "1.0.0",
  "private": true,
  "description": "原创中文浏览器小游戏合集",
  "workspaces": ["apps/*"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "build": "tsc --noEmit -p apps/cloud-garden/tsconfig.json && vite build",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": { "vite": "^7.3.7" }
}
